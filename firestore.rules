rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user owns the document (by uid field)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is an admin (role-based from users collection)
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Check if the user's email is verified
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Check if a user has a specific role
    function hasRole(role) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Check if user is a Seller or Admin
    function canCreateListings() {
      return hasRole('Seller') || isAdmin();
    }

    // Check if user account is not deactivated
    function isNotDeactivated() {
      return isAuthenticated() && 
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDeactivated', false) == false);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Users can create their own profile
      allow create: if isOwner(userId);

      // Users can update their own profile, admin can update any
      allow update: if isOwner(userId) || isAdmin();

      // Only admin can delete user profiles
      allow delete: if isAdmin();

      // Reviews subcollection
      match /reviews/{reviewId} {
        // Anyone authenticated can read reviews
        allow read: if isAuthenticated();

        // Authenticated users can create reviews (reviewId should be reviewer's uid)
        allow create: if isAuthenticated() && reviewId == request.auth.uid;

        // Users can update their own review
        allow update: if isAuthenticated() && reviewId == request.auth.uid;

        // Users can delete their own review, admin can delete any
        allow delete: if (isAuthenticated() && reviewId == request.auth.uid) || isAdmin();
      }
    }

    // ============================================
    // POSTS COLLECTION
    // ============================================
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if isAuthenticated();

      // Only Sellers and Admin can create posts
      allow create: if isAuthenticated() && canCreateListings() && isNotDeactivated();

      // Post owner or admin can update
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());

      // Post owner or admin can delete
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================
    // CHATS COLLECTION
    // ============================================
    match /chats/{chatId} {
      // Only participants can read the chat
      allow read: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;

      // Authenticated users can create chats (must include themselves)
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;

      // Only participants can update the chat
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;

      // Prevent chat deletion
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Only chat participants can create messages
        allow create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;

        // Message sender can update (for future edit feature)
        allow update: if isAuthenticated() && 
          resource.data.senderId == request.auth.uid;

        // Message sender can delete their own messages
        allow delete: if isAuthenticated() && 
          resource.data.senderId == request.auth.uid;
      }
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notifId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;

      // Authenticated users can create notifications (for others)
      allow create: if isAuthenticated();

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;

      // Users can delete their own notifications, admin can delete any
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ============================================
    // REPORTS COLLECTION
    // ============================================
    match /reports/{reportId} {
      // Only admin can read all reports
      allow read: if isAdmin();

      // Any authenticated user can create a report
      allow create: if isAuthenticated() && isNotDeactivated();

      // Only admin can update reports (resolve/dismiss)
      allow update: if isAdmin();

      // Only admin can delete reports
      allow delete: if isAdmin();
    }

    // ============================================
    // ACTIVITY LOGS COLLECTION (append-only, tamper-proof)
    // ============================================
    match /activityLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // Backend/admins can create logs, but no user can edit or delete
      allow create: if isAuthenticated();

      // Logs cannot be updated or deleted (tamper-proof)
      allow update, delete: if false;
    }

    // ============================================
    // EMAIL BROADCASTS COLLECTION
    // ============================================
    match /emailBroadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // DENY ALL OTHER COLLECTIONS BY DEFAULT
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
